{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "extractorModel",
      "type": "promptString",
      "description": "Extractor model — bare id when a base URL is set (e.g. llama3.2:3b, openai/gpt-5.6-luna)",
      "default": "z-ai/glm-5.3-flash"
    },
    {
      "id": "extractorBaseApi",
      "type": "promptString",
      "description": "Extractor base URL — leave blank for LiteLLM provider routing (then prefix the model, e.g. openrouter/...)",
      "default": "https://openrouter.ai/api/v1"
    },
    {
      "id": "checkerModel",
      "type": "promptString",
      "description": "Checker model — bare id when a base URL is set (e.g. llama3.2:3b, openai/gpt-5.6-luna)",
      "default": "z-ai/glm-5.3-flash"
    },
    {
      "id": "checkerBaseApi",
      "type": "promptString",
      "description": "Checker base URL — leave blank for LiteLLM provider routing (then prefix the model, e.g. openrouter/...)",
      "default": "https://openrouter.ai/api/v1"
    },
    {
      "id": "atomizerModel",
      "type": "promptString",
      "description": "Atomizer model — measures whether extracted claims are atomic. Needs ATOMIZER_API_KEY.",
      "default": "z-ai/glm-5.3-flash"
    },
    {
      "id": "atomizerBaseApi",
      "type": "promptString",
      "description": "Atomizer base URL — leave blank for LiteLLM provider routing",
      "default": "https://openrouter.ai/api/v1"
    }
  ],
  "configurations": [
    {
      "name": "01 · extract — kepler22b",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/claimlens",
      "args": [
        "extract",
        "examples/extract/kepler22b.json",
        "--extractor-model",
        "${input:extractorModel}",
        "--extractor-base-api",
        "${input:extractorBaseApi}"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "1 · Walkthrough",
        "order": 1
      }
    },
    {
      "name": "02 · check — kepler22b (extracted)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/claimlens",
      "args": [
        "check",
        "examples/check/kepler22b_extracted.json",
        "--extractor-model",
        "openai/gpt-5.6-luna",
        "--checker-model",
        "${input:checkerModel}",
        "--checker-base-api",
        "${input:checkerBaseApi}"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "1 · Walkthrough",
        "order": 2
      }
    },
    {
      "name": "03 · refcheck — kepler22b",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/claimlens",
      "args": [
        "refcheck",
        "examples/refcheck/kepler22b.json",
        "--extractor-model",
        "${input:extractorModel}",
        "--extractor-base-api",
        "${input:extractorBaseApi}",
        "--checker-model",
        "${input:checkerModel}",
        "--checker-base-api",
        "${input:checkerBaseApi}",
        "--debug"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "1 · Walkthrough",
        "order": 3
      }
    },
    {
      "name": "04 · faithcheck — kepler22b",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/claimlens",
      "args": [
        "faithcheck",
        "examples/faithcheck/kepler22b.json",
        "--extractor-model",
        "${input:extractorModel}",
        "--extractor-base-api",
        "${input:extractorBaseApi}",
        "--checker-model",
        "${input:checkerModel}",
        "--checker-base-api",
        "${input:checkerBaseApi}",
        "--runs",
        "2"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "1 · Walkthrough",
        "order": 4
      }
    },
    {
      "name": "05 · ragcheck — kepler22b",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/claimlens",
      "args": [
        "ragcheck",
        "examples/ragcheck/kepler22b.json",
        "--extractor-model",
        "${input:extractorModel}",
        "--extractor-base-api",
        "${input:extractorBaseApi}",
        "--checker-model",
        "${input:checkerModel}",
        "--checker-base-api",
        "${input:checkerBaseApi}",
        "--runs",
        "2"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "presentation": {
        "group": "1 · Walkthrough",
        "order": 5
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/claimlens",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "name": "01 · eval checker — msmarco_gpt4_5‚",
      "args": [
        "eval",
        "checker",
        "eval_data/msmarco/msmarco_gpt4_25.json",
        "--checker-model",
        "${input:checkerModel}",
        "--checker-base-api",
        "${input:checkerBaseApi}",
        "--runs",
        "1"
      ],
      "presentation": {
        "group": "2 · Evaluation",
        "order": 1
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/claimlens",
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "name": "02 · eval extractor — msmarco_gpt4_25",
      "args": [
        "eval",
        "extractor",
        "eval_data/msmarco/msmarco_gpt4_5.json",
        "--extractor-model",
        "${input:extractorModel}",
        "--extractor-base-api",
        "${input:extractorBaseApi}",
        "--checker-model",
        "${input:checkerModel}",
        "--checker-base-api",
        "${input:checkerBaseApi}",
        "--runs",
        "2"
      ],
      "presentation": {
        "group": "2 · Evaluation",
        "order": 2
      }
    }
  ]
}
