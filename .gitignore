# ── Build / Dist ─────────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Virtual Environments ────────────────────────────────────────────────────
.venv/
venv/

# ── IDE ──────────────────────────────────────────────────────────────────────
# launch.json is shared: it documents the standard workflows. Everything else
# under .vscode/ is personal.
.vscode/*
!.vscode/launch.json
.idea/

# ── Test / Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Secrets / Env ────────────────────────────────────────────────────────────
*.env
.env

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Results (local runs) ────────────────────────────────────────────────────
# Outputs land next to their input, so examples/ and eval_data/ grow their own.
**/results/

ignore-found-bugs.md

agent.md

.rag_crash_cache.db
eval_cases_reference.md